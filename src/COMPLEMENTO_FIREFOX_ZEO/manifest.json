{
  "manifest_version": 2,
  "name": "ZEO - Descargar video",
  "version": "1.1.0",
  "description": "Sends the current page to Zeo Video Downloader for owned or authorized content.",
  "browser_specific_settings": {
    "gecko": {
      "id": "zeo-downloader@local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "activeTab",
    "tabs",
    "notifications",
    "http://127.0.0.1:17835/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "ZEO: descargar video de esta página",
    "default_icon": {
      "48": "icons/zeo.svg"
    }
  },
  "icons": {
    "48": "icons/zeo.svg",
    "96": "icons/zeo.svg"
  }
}
